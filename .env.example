# App
NODE_ENV=development
PORT=3000
# En producción: dominio real del frontend, nunca "*" (credentials: true en CORS lo prohíbe además)
CORS_ORIGIN=http://localhost:4200

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=estaeslamia
DB_PASSWORD=estaeslamia
DB_NAME=estaeslamia
DATABASE_URL=postgresql://estaeslamia:estaeslamia@localhost:5432/estaeslamia
# true cuando la base es Supabase/Neon/cualquier Postgres administrado que exija SSL.
# false para el Postgres local de Docker (no lo necesita).
DB_SSL=false

# JWT
# NUNCA uses este valor tal cual en producción. Genera uno real con:
#   openssl rand -base64 48
# (o en Windows sin OpenSSL: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# El servidor se niega a arrancar en producción (NODE_ENV=production) si detecta
# el valor por defecto o un secret de menos de 32 caracteres — ver backend/src/main.ts
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Supabase Storage (subida de logos de empresas)
# Sin configurar: POST /providers/me/logo devuelve un error claro, el resto de la app funciona normal.
# Pasos: Supabase → Storage → New bucket "provider-logos" marcado como PUBLIC.
# SUPABASE_URL: Project Settings → API → Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (SECRETA: solo backend, nunca en el frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=provider-logos

# Sentry (monitoreo de errores en producción)
# Sin configurar: no hace nada, no rompe el arranque local.
# Consíguelo gratis en https://sentry.io/ → Create Project → Node.js (backend) / Angular (frontend)
SENTRY_DSN=

# Cloudflare Turnstile (anti-bot en formularios públicos: solicitud, registro customer/provider)
# Sin configurar: la verificación se omite automáticamente (modo desarrollo).
# Consíguelas gratis en https://dash.cloudflare.com/ → Turnstile → Add site
TURNSTILE_SECRET_KEY=
# Esta va en el frontend (environment.ts), no es secreta — se expone en el HTML igual
TURNSTILE_SITE_KEY=
