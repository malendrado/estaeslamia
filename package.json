{
  "name": "estaeslamia",
  "version": "0.1.0",
  "private": true,
  "description": "EstaEsLaMía.cl — Plataforma de generación de leads (workspace: API + APP)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",

    "api:dev": "npm run start:dev --workspace=backend",
    "api:build": "npm run build --workspace=backend",
    "api:migration:run": "npm run migration:run --workspace=backend",
    "api:migration:revert": "npm run migration:revert --workspace=backend",
    "api:seed": "npm run seed --workspace=backend",
    "api:test": "npm run test --workspace=backend",
    "api:test:e2e": "npm run test:e2e --workspace=backend",

    "app:dev": "npm run start --workspace=frontend",
    "app:build": "npm run build --workspace=frontend",
    "app:e2e": "npm run e2e --workspace=frontend",

    "dev": "npm run db:up && concurrently -n API,APP -c blue,green \"npm run api:dev\" \"npm run app:dev\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",

    "setup": "npm install && npm run db:up && npm run api:migration:run && npm run api:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
